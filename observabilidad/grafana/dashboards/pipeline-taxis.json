      "title": "Avisos de Postgres (caídas, checkpoints, errores)",
      "description": "Si Postgres vuelve a morir con exit code 2, aparece acá.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{servicio=\"postgres\"} |~ \"exit code|terminated|PANIC|FATAL|ERROR|checkpoints are occurring|reinitializ|out of memory\"",
