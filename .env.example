# Plantilla de .env. Si no hay .env, `make all` copia este archivo.
# Las credenciales son solo para el Postgres del contenedor, que escucha en 127.0.0.1.
PGHOST=localhost
PGPORT=5435
PGDATABASE=taxis
PGUSER=taxis
PGPASSWORD=taxis_local

# Formato de carga de dlt: csv (por defecto, usa COPY) o insert_values (INSERT por valores).
INGESTA_FORMATO=csv

# Tablero opcional en Metabase (make viz). Usuario administrador que se crea la primera vez.
MB_PUERTO=3001
MB_ADMIN_EMAIL=admin@taxis.local
MB_ADMIN_PASSWORD=tablero_local_2026
